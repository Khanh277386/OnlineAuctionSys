<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="850.0" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginFormController">
    <!-- KHU VỰC NÚT BACK (NẰM Ở GÓC TRÊN TRÁI) -->
    <top>
        <HBox alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <padding>
                <Insets left="20.0" top="20.0" />
            </padding>
            <children>
                <Button mnemonicParsing="false" onAction="#onBackClick" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-text-fill: #151a22; -fx-padding: 0;" text="← Back">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- NỘI DUNG CHÍNH NẰM Ở GIỮA -->
    <center>
        <VBox alignment="CENTER" spacing="25.0" BorderPane.alignment="CENTER">
            <children>
                <!-- Nhóm Tiêu đề (UET AUCTION) -->
                <VBox alignment="CENTER" spacing="-20.0">
                    <children>
                        <Label text="UET" textFill="#151a22">
                            <font>
                                <Font name="System Bold" size="80.0" />
                            </font>
                        </Label>
                        <Label text="AUCTION" textFill="#151a22">
                            <font>
                                <Font name="System Bold" size="80.0" />
                            </font>
                        </Label>
                    </children>
                    <VBox.margin>
                        <Insets bottom="10.0" />
                    </VBox.margin>
                    <effect>
                        <DropShadow color="#00000033" offsetX="3.0" offsetY="5.0" radius="10.0" />
                    </effect>
                </VBox>

                <!-- Nút LOGIN -->
                <Button alignment="CENTER" focusTraversable="false" mnemonicParsing="false" onAction="#onConnectClick" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-background-radius: 12; -fx-cursor: hand;" text="LOGIN">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Button>

                <!-- Khung Form nhập liệu -->
                <VBox alignment="CENTER" spacing="15.0">
                    <children>
                        <!-- Hàng 1: Username -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label alignment="CENTER_RIGHT" prefWidth="85.0" text="Username:">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="usernameField" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 0;" />
                                <Region prefWidth="85.0" />
                            </children>
                        </HBox>

                        <!-- Hàng 2: Password -->
                        <HBox alignment="CENTER" spacing="10.0">
                            <children>
                                <Label alignment="CENTER_RIGHT" prefWidth="85.0" text="Password:">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="passwordField" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 0;" />
                                <Region prefWidth="85.0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
            <BorderPane.margin>
                <Insets bottom="40.0" />
            </BorderPane.margin>
        </VBox>
    </center>
</BorderPane>