<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="680.0" prefWidth="1050.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.BidderMainController">

    <!-- TOP HEADER: BIDDER INFO, WALLET BALANCE & ADD FUNDS -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="72.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="12.0" left="25.0" right="25.0" top="12.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_LEFT">
                    <children>
                        <Label text="LIVE AUCTION MARKET" textFill="#151A22">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label text="Explore active sessions &amp; place your bids" textFill="#718096">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Wallet Balance mapped from Bidder.getBalance() -->
                <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #EDF2F7; -fx-padding: 8 14; -fx-background-radius: 8;">
                    <children>
                        <Label fx:id="balanceLabel" text="Balance: $0" textFill="#2B6CB0">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </Label>
                        <Button onAction="#onAddFund" style="-fx-background-color: #2B6CB0; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="+ Add Funds">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <children>
                        <Label fx:id="welcomeLabel" text="Bidder: User" textFill="#151A22">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <Label text="Role: BIDDER" textFill="#4A5568">
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <Button onAction="#onLogout" style="-fx-background-color: #FFF5F5; -fx-border-color: #FEB2B2; -fx-border-radius: 6; -fx-text-fill: #E53E3E; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="Logout">
                    <padding>
                        <Insets bottom="8.0" left="14.0" right="14.0" top="8.0" />
                    </padding>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- CENTER: AUCTION TABLE (LEFT) & ITEM DETAILS + BID HISTORY + BIDDING PANEL (RIGHT) -->
    <center>
        <HBox spacing="20.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <children>

                <!-- LEFT COLUMN: FILTER BAR & TABLEVIEW<AUCTION> -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" prefHeight="36.0" prefWidth="220.0" promptText="Search item name..." style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E0; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <ComboBox fx:id="categoryFilterBox" prefHeight="36.0" prefWidth="150.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E0; -fx-border-radius: 6; -fx-background-radius: 6;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onRefresh" prefHeight="36.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #CBD5E0; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand;" text="Refresh">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <TableView fx:id="auctionTableView" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E2E8F0;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="itemCol" prefWidth="170.0" text="Item Name" />
                                <TableColumn fx:id="typeCol" prefWidth="95.0" text="Category" />
                                <TableColumn fx:id="priceCol" prefWidth="125.0" text="Current Price" />
                                <TableColumn fx:id="incrementCol" prefWidth="105.0" text="Bid Increment" />
                                <TableColumn fx:id="endTimeCol" prefWidth="130.0" text="End Time" />
                                <TableColumn fx:id="statusCol" prefWidth="95.0" text="Status" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>

                <!-- RIGHT COLUMN: ITEM DETAILS, BID HISTORY & BIDDING ACTION -->
                <VBox prefWidth="360.0" spacing="12.0" style="-fx-background-color: #FFFFFF; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10;">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <effect>
                        <DropShadow blurType="GAUSSIAN" height="15.0" radius="7.0" width="15.0">
                            <color>
                                <Color opacity="0.06" />
                            </color>
                        </DropShadow>
                    </effect>
                    <children>
                        <Label text="AUCTION DETAILS" textFill="#151A22">
                            <font>
                                <Font name="System Bold" size="15.0" />
                            </font>
                        </Label>

                        <!-- General Info + Polymorphic Specs (Electronic / Art / Vehicle) -->
                        <VBox spacing="5.0" style="-fx-background-color: #F8FAFC; -fx-padding: 12; -fx-background-radius: 8; -fx-border-color: #EDF2F7; -fx-border-radius: 8;">
                            <children>
                                <Label fx:id="itemNameLabel" text="Item: None selected" textFill="#151A22" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <Label fx:id="itemDescLabel" text="Description: ---" textFill="#4A5568" wrapText="true">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Label fx:id="sellerLabel" text="Seller: ---" textFill="#4A5568">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <Label fx:id="spec1Label" text="Spec 1: ---" textFill="#2D3748">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label fx:id="spec2Label" text="Spec 2: ---" textFill="#2D3748">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Current Price, Minimum Bid & Leading Bidder -->
                        <VBox spacing="4.0">
                            <children>
                                <Label fx:id="currentPriceLabel" text="Current Price: $0" textFill="#2B6CB0">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>
                                <Label fx:id="minBidLabel" text="Minimum Bid: $0" textFill="#2F855A">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <Label fx:id="leadingBidderLabel" text="Leading Bidder: None" textFill="#718096">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Bid History TableView<Bid> -->
                        <Label text="Bid History:" textFill="#4A5568">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <TableView fx:id="bidHistoryTable" prefHeight="130.0" style="-fx-border-color: #E2E8F0; -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="bidderCol" prefWidth="110.0" text="Bidder" />
                                <TableColumn fx:id="bidAmountCol" prefWidth="110.0" text="Amount" />
                                <TableColumn fx:id="bidTimeCol" prefWidth="95.0" text="Time" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- Input & Action Buttons -->
                        <VBox spacing="8.0">
                            <children>
                                <TextField fx:id="bidAmountField" prefHeight="38.0" promptText="Enter bid amount..." style="-fx-background-radius: 6; -fx-border-color: #CBD5E0; -fx-border-radius: 6;" />
                                <HBox spacing="10.0">
                                    <children>
                                        <Button maxWidth="1.7976931348623157E308" onAction="#onPlaceBid" prefHeight="40.0" style="-fx-background-color: #151A22; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="PLACE BID" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="payButton" disable="true" onAction="#onPayWonAuction" prefHeight="40.0" style="-fx-background-color: #2F855A; -fx-text-fill: #FFFFFF; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="PAY NOW" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>

            </children>
        </HBox>
    </center>
</BorderPane>