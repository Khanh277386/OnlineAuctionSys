<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="500.0" prefWidth="850.0" spacing="25.0" style="-fx-background-color: #F4F7F6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.RegisterFormController">
    <children>
        <!-- Nhóm Tiêu đề (UET AUCTION) -->
        <VBox alignment="CENTER" spacing="-20.0">
            <children>
                <Label text="UET" textFill="#151a22">
                    <font>
                        <Font name="System Bold" size="80.0" />
                    </font>
                </Label>
                <Label text="AUCTION" textFill="#151a22">
                    <font>
                        <Font name="System Bold" size="80.0" />
                    </font>
                </Label>
            </children>
            <VBox.margin>
                <Insets bottom="10.0" />
            </VBox.margin>
            <effect>
                <DropShadow color="#00000033" offsetX="3.0" offsetY="5.0" radius="10.0" />
            </effect>
        </VBox>

        <!-- Nút ĐĂNG KÝ -->
        <Button alignment="CENTER" focusTraversable="false" mnemonicParsing="false" onAction="#onRegisterSubmit" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: #000000; -fx-text-fill: #FFFFFF; -fx-background-radius: 12; -fx-cursor: hand;" text="REGISTER">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Button>

        <!-- Khung Form nhập liệu -->
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <!-- Hàng 1: Tên đăng nhập -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label alignment="CENTER_RIGHT" prefWidth="110.0" text="Username:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 0;" />
                        <Region prefWidth="110.0" />
                    </children>
                </HBox>

                <!-- Hàng 2: Mật khẩu -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label alignment="CENTER_RIGHT" prefWidth="110.0" text="Password:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 0;" />
                        <Region prefWidth="110.0" />
                    </children>
                </HBox>

                <!-- Hàng 3: Vai trò (ComboBox) -->
                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Label alignment="CENTER_RIGHT" prefWidth="110.0" text="Role:">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <!-- ComboBox chọn Role -->
                        <ComboBox fx:id="roleComboBox" prefHeight="32.0" prefWidth="300.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #000000; -fx-border-width: 1.5; -fx-border-radius: 0; -fx-font-size: 14px; -fx-font-weight: bold;">
                            <!-- Nạp sẵn danh sách lựa chọn -->
                            <items>
                                <FXCollections fx:factory="observableArrayList">
                                    <String fx:value="Bidder" />
                                    <String fx:value="Seller" />
                                </FXCollections>
                            </items>
                            <!-- Đặt giá trị mặc định được chọn sẵn là Bidder -->
                            <value>
                                <String fx:value="Bidder" />
                            </value>
                        </ComboBox>
                        <Region prefWidth="110.0" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>